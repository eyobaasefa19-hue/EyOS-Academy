generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id               String   @id @default(uuid())
  email            String   @unique
  username         String?  // 🌟 ለ UI Dashboard የተጨመረ
  fullName         String?
  avatarUrl        String?  // 🌟 [NEW] ለፕሮፋይል ፎቶ የተጨመረ
  bio              String?  // 🌟 [NEW] ለፕሮፋይል ማብራሪያ የተጨመረ
  xpPoints         Int      @default(0)
  coins            Int      @default(100) // 🌟 ለተማሪዎች ሽልማት/ኮይንስ
  streak           Int      @default(0)
  currentLevel     Int      @default(1)   // 🌟 የተማሪው ደረጃ (Level)
  dailyGoalPercent Int      @default(0)   // 🌟 የቀን ግብ (Daily Goal %)
  lastActive       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ግንኙነቶች (Relations)
  progress    LessonProgress[]
  enrollments Enrollment[]
  payments    Payment[]
}

model Course {
  id            String   @id @default(uuid())
  title         String
  subtitle      String?  // 🌟 ለ UI የተጨመረ
  description   String
  category      String?  // 🌟 ለ UI የተጨመረ
  price         Float    @default(0.0) 
  discountPrice Float?   // 🌟 ለ UI የተጨመረ
  thumbnail     String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  payments    Payment[]
}

model Lesson {
  id            String   @id @default(uuid())
  title         String
  chapterTitle  String?  // 🌟 ትምህርቶችን በክፍል ለመለየት
  duration      String?  // 🌟 የቪዲዮ ርዝመት
  content       String?  
  videoUrl      String?  
  order         Int      
  isFreePreview Boolean  @default(false) // 🌟 ተማሪዎች ሳይከፍሉ እንዲሞክሩት
  courseId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  score       Int      @default(0)
  lastPlayed  DateTime @default(now()) @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  amount    Float
  currency  String   @default("ETB")
  status    String   @default("PENDING") // PENDING, COMPLETED, FAILED
  txRef     String   @unique 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}
